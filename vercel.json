{
  "redirects": [
    { "source": "/(.*)", "has": [ { "type": "host", "value": "mishpacha-tours-site.vercel.app" } ], "destination": "https://mishpachatours.com/$1", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" } ] }
  ]
}
