<script>
const m=document.querySelector('.menu'),pa=document.getElementById('panneau');
m.addEventListener('click',()=>{const o=pa.hidden;pa.style.top=document.querySelector('.nav').getBoundingClientRect().bottom+'px';pa.hidden=!o;m.setAttribute('aria-expanded',o);document.body.classList.toggle('menu-ouvert',o)});
pa.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{pa.hidden=true;m.setAttribute('aria-expanded',false);document.body.classList.remove('menu-ouvert')}));
document.querySelectorAll('.filtres button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.filtres button').forEach(x=>{x.classList.toggle('actif',x===b);x.setAttribute('aria-pressed',x===b)});const t=b.dataset.type;document.querySelectorAll('.carte').forEach(c=>{c.hidden=t!=='all'&&c.dataset.type!==t});document.querySelector('.rail').scrollTo({left:0,behavior:'smooth'})}));
if(matchMedia('(min-width:900px)').matches)document.querySelectorAll('.pied details').forEach(d=>d.open=true);
document.getElementById('chercheur')&&document.getElementById('chercheur').addEventListener('submit',e=>{e.preventDefault();const f=e.target;const t=`Hello, I would like to check availability for the ${f.tour.value} tour. Dates: ${f.dates.value||'/'} / Number of people: ${f.personnes.value||'/'} / Preferred language:`;window.open('https://wa.me/33652092301?text='+encodeURIComponent(t),'_blank','noopener')});
</script>
